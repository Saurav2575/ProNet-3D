PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/pronet
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_ACCESS_EXPIRES_IN=15m
CLIENT_URL=http://localhost:5173
# Optional; local image uploads work without these values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional; falls back to a bounded local memory cache if unavailable.
REDIS_URL=redis://127.0.0.1:6379
# Email sending is opt-in and off by default.
EMAIL_NOTIFICATIONS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Set to 1 only behind one trusted reverse proxy.
TRUST_PROXY=0
